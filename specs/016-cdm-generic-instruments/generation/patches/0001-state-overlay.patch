+      - ./observability/tempo/config.yaml:/etc/tempo/config.yaml:ro
+    ports:
+      - "3200:3200"
+
+  grafana:
+    image: grafana/grafana:11.1.0
+    environment:
+      GF_SECURITY_ADMIN_USER: "${TRADERX_GRAFANA_ADMIN_USER:-traderx-admin}"
+      GF_SECURITY_ADMIN_PASSWORD: "${TRADERX_GRAFANA_ADMIN_PASSWORD:-traderx-state-009}"
+      GF_USERS_ALLOW_SIGN_UP: "false"
+      GF_AUTH_ANONYMOUS_ENABLED: "${TRADERX_GRAFANA_ANONYMOUS_ENABLED:-true}"
+      GF_AUTH_ANONYMOUS_ORG_ROLE: "${TRADERX_GRAFANA_ANONYMOUS_ORG_ROLE:-Viewer}"
+      GF_SERVER_ROOT_URL: "${TRADERX_GRAFANA_ROOT_URL:-%(protocol)s://%(domain)s/grafana/}"
+      GF_SERVER_SERVE_FROM_SUB_PATH: "true"
+    volumes:
+      - ./observability/grafana/provisioning:/etc/grafana/provisioning:ro
